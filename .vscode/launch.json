{
    "version": "0.2.0",
    "configurations": [
    {
        "name": "→PDF Pandoc file corrente",
        "type": "node-terminal",
        "request": "launch",
        "command": "pandoc \"${file}\" -f markdown+link_attributes -o \"${fileDirname}/../out/${fileBasenameNoExtension}.pdf\" --pdf-engine=xelatex --resource-path=\"${fileDirname};${fileDirname}/imgs\" -H \"${workspaceFolder}/005_authoring/latex/header1.tex\"",
        "cwd": "${workspaceFolder}"
    },

    {
        "name": "-> RO PDF readonly.py con argomento",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/005_authoring/python/readonly.py",
        "console": "integratedTerminal",
        "args": [ "${fileDirname}\\.."  ]
    }, 


    {
        "name": "TCP Receiver",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/tcp/tcp_receiver.exe",
        "args": [],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}/tcp",
        "environment": [],
        "externalConsole": true,
        "MIMode": "gdb",
        "miDebuggerPath": "gdb"
    },
    {
        "name": "UDP Receiver",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/udp/udp_receiver.exe",
        "args": [],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}/udp",
        "environment": [],
        "externalConsole": true,
        "MIMode": "gdb",
        "miDebuggerPath": "gdb"
    }
]
}